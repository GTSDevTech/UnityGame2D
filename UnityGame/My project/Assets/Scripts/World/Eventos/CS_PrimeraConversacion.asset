  m_Script: {fileID: 11500000, guid: 4d47e02d5c9d7b64e9621c9ecea04bcd, type: 3}
  m_Name: CS_PrimeraConversacion
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneSequence
  lines:
  - speakerName: Corrupto
    text: "Vaya, parece que hemos robado tanto que hemos quebrado al Pa\xEDs, ser\xE1
      mejor que nos vayamos antes de que nos encuentren... Yo que tu no volver\xEDa
      atr\xE1s..."
    speakerTransform: {fileID: 0}
  - speakerName: Corrupto
    text: "Si yo fuese tu, intentar\xEDa llegar al aeropuerto y largarme en el Falconeti...
      No olvides robar todo el dinero que puedas por el camino, seguro que te ser\xE1
      \xFAtil jejeje"
    speakerTransform: {fileID: 0}
