  m_Script: {fileID: 11500000, guid: 4d47e02d5c9d7b64e9621c9ecea04bcd, type: 3}
  m_Name: CS_Conversacion_coche
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneSequence
  lines:
  - speakerName: Avalible
    text: "Hombreee, que pasa Perro! Aqu\xED estabamos con una amigas, se est\xE1
      poniendo la cosa chunga, nosotros nos vamos al aeropuesto... \xBFNo os ven\xEDs
      ninguna?"
    speakerTransform: {fileID: 0}
  - speakerName: Kodos
    text: "\xBFTe acuerdas de los tiempos de la banda de Peugeot? Vaya pelotazo metimos,
      yo pas\xE9 de portero a Fontanero jajaja"
    speakerTransform: {fileID: 0}
  - speakerName: "Santa Cerde\xF1a"
    text: Yo mejor no hablo mucho que soy un bocaza... Pero date prisa, nos espera
      un vuelo a Republica Dominicana!!
    speakerTransform: {fileID: 0}
